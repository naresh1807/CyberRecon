include LICENSE README.md USER_MANUAL.md CYBERRECON.md
recursive-include cyberrecon/assets *.svg
recursive-include scripts *.py *.sh
recursive-include tests *.py
recursive-include workers *.go go.mod *.md
recursive-include docs *.md
recursive-include release *.txt
recursive-include .github/workflows *.yml
prune docs/release-evidence
prune reference
prune .release-qualification
prune build
prune dist
prune .venv
global-exclude __pycache__ *.py[cod]
